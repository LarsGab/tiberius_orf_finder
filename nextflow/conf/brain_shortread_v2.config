// SLURM settings for the group's 'brain' HPC cluster, for the VARUS v2
// short-read data-generation pipeline (`nextflow/main_shortread_v2.nf`).
//
// Usage:
//   nextflow run nextflow/main_shortread_v2.nf \
//     -c nextflow/conf/brain_shortread_v2.config \
//     --species_csv nextflow/conf/<clade>/species_<split>.csv \
//     --outdir /home/gabriell/tiberius_orf_finder/results/<run>

process {
    executor = 'slurm'
    queue    = 'snowball,pinky,batch'
    time     = '24h'
    memory   = '8 GB'
    cpus     = 4
    beforeScript = 'eval "$(micromamba shell hook --shell bash)" && micromamba activate orffinder'
    // Nodes where the wrapper dies at 0s with exit 1:0 and no .command.log
    // (most likely micromamba/env unreachable on those nodes). Excluded
    // until cluster admins fix them; re-test by removing one at a time.
    clusterOptions = '--exclude=node206,node231,node232,node233'

    withName: FETCH_ASSEMBLY {
        cpus          = 2
        memory        = '4 GB'
        time          = '4h'
        // Retry transient NCBI / staging hiccups, then drop the species.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }
    withName: VARUS_RUNLIST_SR {
        cpus          = 1
        memory        = '2 GB'
        time          = '2h'
        // Some species have no SRA RNA-seq runs at all (e.g. binomials
        // ending in 'sp.' with isolated GCA submissions). VARUS raises
        // RuntimeError in that case; treat it the same as VARUS_RUN_SR
        // data-quality failures and just drop the species.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: VARUS_INDEX_SR {
        cpus          = 8
        // Multi-Gb plant genomes (Thinopyrum / Nicotiana / Gossypium / Glycine,
        // 1-4.3 Gb) OOM HISAT2-build at 32 GB. 128 GB covers the worst case
        // and is still within snowball/pinky availability. For >4 Gb
        // genomes (caecilians, lungfish, salamanders -- the .ht2l "long
        // index" branch) hisat2-build also blows past 6 h, so escalate
        // memory per attempt; time is pinned at the brain 72 h cap.
        memory        = { 128.GB * task.attempt }   // 128 -> 256
        time          = '72h'
        // Without retry+ignore, one big-genome index failure terminates
        // the whole pipeline and kills sibling tasks. Treat like
        // VARUS_RUN_SR: retry twice, then drop the species.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: VARUS_RUN_SR {
        cpus          = 16
        memory        = '32 GB'
        time          = '72h'
        // Retry transient failures up to 2x, then drop the species from the
        // run instead of failing the whole pipeline. Per-species SRA quality
        // varies wildly (e.g. only 0.5% uniq-mapping reads in the single
        // available run for some Chlorophyta), and the resulting
        // tfrecord_manifest.tsv simply lists fewer species.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        maxForks      = 5
    }
    withName: RUN_STRINGTIE {
        cpus   = 16
        // Vertebrate VARUS BAMs (>100M reads) push samtools-sort +
        // StringTie peak RSS well past 32 GB. Escalate per attempt so
        // small clades stay cheap but big genomes get headroom.
        memory = { 32.GB * task.attempt }   // 32 -> 64 -> 96
        time   = { 24.h  * task.attempt }
        // Retry any failure twice (covers OOM, walltime, node-specific
        // brokenness where the wrapper dies before flushing logs --
        // SLURM almost always reschedules onto a different node on
        // retry). Drop the species after exhaustion instead of
        // terminating the whole pipeline.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: LABEL_TRANSCRIPTS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }
    withName: WRITE_TFRECORD {
        cpus   = 2
        memory = { 60.GB * task.attempt }
        // Vertebrate transcript shards (100M+ reads -> many chunks)
        // blow past 4 h; pin at the brain 72 h cap.
        time   = '72h'
        // Without retry+ignore, one walltime/OOM kill terminates the
        // whole pipeline and kills sibling tasks.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
}

executor {
    queueSize = 50
}

env {
    PYTHONPATH = '/home/gabriell/tiberius_orf_finder/src'
    // Make the new VARUS v2 install discoverable. The CLI is invoked as
    // `python -m varus.cli`, so this matters only if the orffinder env
    // hasn't pip-installed varus directly.
    PATH       = '/home/gabriell/VARUS/bin:$PATH'
}

// Raw inputs and outputs intentionally live OUTSIDE the repo under:
//   /home/gabriell/tiberius_orf_finder/raw/      (read-only raw data)
//   /home/gabriell/tiberius_orf_finder/results/  (pipeline outputs)
params {
    outdir              = '/home/gabriell/tiberius_orf_finder/results'
    braker_data_dir     = '/home/nas-hs/projs/tiberius-insects/data/insects_data_braker'
    phytozome_data_dir  = '/home/gabriell/tiberius_mesangiospermae_training_data/by_species'

    varus_max_batches = 1000
    varus_batch_size  = 50000
    chunk_len         = 9999
}
