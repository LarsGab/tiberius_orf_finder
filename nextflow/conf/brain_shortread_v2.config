// SLURM settings for the group's 'brain' HPC cluster, for the VARUS v2
// short-read data-generation pipeline (`nextflow/main_shortread_v2.nf`).
//
// Usage:
//   nextflow run nextflow/main_shortread_v2.nf \
//     -c nextflow/conf/brain_shortread_v2.config \
//     --species_csv nextflow/conf/<clade>/species_<split>.csv \
//     --outdir /home/gabriell/tiberius_orf_finder/results/<run>

process {
    executor = 'slurm'
    queue    = 'snowball,pinky,batch'
    time     = '24h'
    memory   = '8 GB'
    cpus     = 4
    beforeScript = 'eval "$(micromamba shell hook --shell bash)" && micromamba activate orffinder'

    withName: FETCH_ASSEMBLY {
        cpus          = 2
        memory        = '4 GB'
        time          = '4h'
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withName: VARUS_RUNLIST_SR {
        cpus          = 1
        memory        = '2 GB'
        time          = '2h'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: VARUS_INDEX_SR {
        cpus          = 8
        memory        = '32 GB'
        time          = '6h'
    }
    withName: VARUS_RUN_SR {
        cpus          = 16
        memory        = '32 GB'
        time          = '72h'
        // Retry transient failures up to 2x, then drop the species from the
        // run instead of failing the whole pipeline. Per-species SRA quality
        // varies wildly (e.g. only 0.5% uniq-mapping reads in the single
        // available run for some Chlorophyta), and the resulting
        // tfrecord_manifest.tsv simply lists fewer species.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        maxForks      = 5
    }
    withName: RUN_STRINGTIE {
        cpus   = 16
        memory = '32 GB'
        time   = '24h'
    }
    withName: LABEL_TRANSCRIPTS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }
    withName: WRITE_TFRECORD {
        cpus   = 2
        memory = '60 GB'
        time   = '4h'
    }
}

executor {
    queueSize = 50
}

env {
    PYTHONPATH = '/home/gabriell/tiberius_orf_finder/src'
    // Make the new VARUS v2 install discoverable. The CLI is invoked as
    // `python -m varus.cli`, so this matters only if the orffinder env
    // hasn't pip-installed varus directly.
    PATH       = '/home/gabriell/VARUS/bin:$PATH'
}

// Raw inputs and outputs intentionally live OUTSIDE the repo under:
//   /home/gabriell/tiberius_orf_finder/raw/      (read-only raw data)
//   /home/gabriell/tiberius_orf_finder/results/  (pipeline outputs)
params {
    outdir              = '/home/gabriell/tiberius_orf_finder/results'
    braker_data_dir     = '/home/nas-hs/projs/tiberius-insects/data/insects_data_braker'
    phytozome_data_dir  = '/home/gabriell/tiberius_mesangiospermae_training_data/by_species'

    varus_max_batches = 1000
    varus_batch_size  = 50000
    chunk_len         = 9999
}
