// SLURM settings for long-read training-data generation on the 'brain' HPC.
// Activates the `orffinder` micromamba env, which must have:
//   - varus v2 CLI (pip install -e /home/gabriell/VARUS[align])
//   - minimap2, samtools, fastq-dump, stringtie, gffread, datasets
//   - tiberius_orf (this repo, src on PYTHONPATH)
//
// Run with:
//   nextflow run nextflow/main_longread.nf -c nextflow/conf/brain_longread.config ...

process {
    executor = 'slurm'
    queue    = 'snowball,pinky,batch'
    time     = '24h'
    memory   = '8 GB'
    cpus     = 4
    beforeScript = 'eval "$(micromamba shell hook --shell bash)" && micromamba activate orffinder'

    withName: STAGE_ASSEMBLY {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }
    withName: VARUS_RUNLIST_LR {
        cpus          = 1
        memory        = '2 GB'
        time          = '2h'
        // Limit parallelism so we stay under NCBI's unauthenticated 3 req/s cap
        // even without an API key. The Python CLI also retries on HTTP 429
        // internally, but throttling here is the cheaper first line of defence.
        maxForks      = 3
        // Note: 'ignore' is the right policy for the *terminal* failure mode
        // (count==0 = no long-read data for this species). Transient HTTP 429s
        // are retried inside `varus.runlist._esearch_history` and never reach
        // Nextflow as a failure.
        errorStrategy = 'ignore'
    }
    withName: VARUS_INDEX_LR {
        cpus   = 8
        memory = '32 GB'
        time   = '4h'
    }
    withName: VARUS_RUN_LR {
        cpus          = 16
        memory        = '32 GB'
        time          = '72h'
        errorStrategy = 'retry'
        maxRetries    = 2
        maxForks      = 5
    }
    withName: RUN_STRINGTIE_LR {
        cpus   = 16
        memory = '32 GB'
        time   = '24h'
    }
    withName: LABEL_TRANSCRIPTS {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }
    withName: WRITE_TFRECORD {
        cpus   = 2
        memory = '60 GB'
        time   = '4h'
    }
}

executor {
    queueSize = 50
}

env {
    PYTHONPATH = '/home/gabriell/tiberius_orf_finder/src'
}

// Defaults — override on the CLI as needed.
params {
    outdir              = '/home/gabriell/tiberius_orf_finder/results/training_longread'
    reuse_assembly_dir  = '/home/gabriell/tiberius_orf_finder/results/training'
    braker_data_dir     = '/home/nas-hs/projs/tiberius-insects/data/insects_data_braker'
    varus_max_batches   = 1000
    varus_batch_size    = 2000
    chunk_len           = 9999
    threads             = 16

    // Use the VARUS v2 Python package installed in the active `orffinder`
    // env, NOT the legacy /home/gabriell/programs/VARUS perl binary that
    // currently shadows it on PATH.
    varus_cmd           = 'python -m varus.cli'
}
